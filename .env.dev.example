# Copy this file to .env and fill in values for local dev.
# Never commit .env to version control.

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Grants ingest — object store
# Default (no var needed): filesystem at /tmp/uc-corpus
# Uncomment to override:
# RAW_OBJECT_STORE_FS_PATH=/tmp/uc-corpus
# RAW_OBJECT_STORE_BACKEND=fs

# To use S3:
# RAW_OBJECT_STORE_BACKEND=s3
# RAW_OBJECT_STORE_S3_BUCKET=my-bucket

# Anthropic (only needed for AI-assisted features)
# ANTHROPIC_API_KEY=sk-ant-...
