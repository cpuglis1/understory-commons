# Copy to .env for local development. Never commit .env.
DJANGO_ENV=dev
SECRET_KEY=replace-me-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Leave unset to use SQLite in dev; set to postgres:// for prod
DATABASE_URL=

# Anthropic API key — required for AI attendance parsing
ANTHROPIC_API_KEY=sk-ant-replace-me

# Full base URL used when composing magic-link URLs (no trailing slash)
SITE_URL=http://localhost:8000
